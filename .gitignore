# ---------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------
# The Tailwind standalone CLI is downloaded per-RID at build time by
# src/Dibal.Web/Tailwind.targets. It is never committed — the same repo
# builds on an ARM Mac, a Windows desktop and a linux-x64 container.
tools/

# Tailwind output is generated from the source stylesheet.
src/Dibal.Web/wwwroot/css/app.css

# ---------------------------------------------------------------
# Secrets and local state
# ---------------------------------------------------------------
# Secrets live in `dotnet user-secrets` (local) and Fly secrets (production).
# Nothing below should ever exist in this repo — these are backstops.
appsettings.*.local.json
*.env
.env
.env.*
*.pem
*.pfx

# Serilog rolling file output
logs/

